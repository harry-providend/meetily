# Production environment.
#
# Committed and baked into every build -- non-secret values only. Never an API
# key, client secret, connection string, or password. Entra tenant/client IDs
# are identifiers, not credentials, so they are safe here.
#
# Production uses the base tauri.conf.json identifier.

# Directory (tenant) ID from the Entra app registration.
AUTH_TENANT_ID=

# Application (client) ID from the Entra app registration.
AUTH_CLIENT_ID=

# Our backend base URL. Unused until Phase 2.
API_BASE_URL=
