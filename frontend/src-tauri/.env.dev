# Development environment.
#
# Committed and baked into every build -- non-secret values only. Never an API
# key, client secret, connection string, or password. Entra tenant/client IDs
# are identifiers, not credentials, so they are safe here.
#
# Data isolation comes from the bundle identifier in tauri.dev.conf.json.

# Directory (tenant) ID from the Entra app registration.
AUTH_TENANT_ID=f48c0ae6-adfe-4a0a-8e64-e1a5b0ae30db

# Application (client) ID from the Entra app registration.
AUTH_CLIENT_ID=9a710641-a2b0-422e-b451-5ca5114ab389

# Our backend base URL. Points at a locally-run /server for development; override at runtime
# with MEETILY_API_BASE_URL to aim a dev build at a deployed instance.
API_BASE_URL=http://localhost:8000
