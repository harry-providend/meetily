# Copy to .env for local development. Non-secret identifiers only -- no client secret exists,
# this is a public-client/JWT-resource-server setup (see docs/ENTRA_SIGN_IN.md in the frontend repo).
# 5433, not 5432: see docker-compose.yml -- avoids clashing with a local Postgres.
DATABASE_URL=postgresql+asyncpg://meetily:meetily@localhost:5433/meetily

# Dev tenant. Staging and prod registrations are still placeholders.
ENTRA_TENANT_ID=f48c0ae6-adfe-4a0a-8e64-e1a5b0ae30db

# App ID URI of this API, from the app registration's "Expose an API" blade -- WITHOUT the scope
# name. The scope the desktop app requests is this plus "/user_impersonation"; the audience the
# server validates is just the URI. Both this and the bare GUID are accepted as `aud`, because
# Entra picks between them based on accessTokenAcceptedVersion.
ENTRA_API_APP_ID_URI=api://9a710641-a2b0-422e-b451-5ca5114ab389
